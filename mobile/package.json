{
  "name": "skyway-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 8100 --proxy-config proxy.conf.json --prebundle=false",
    "build": "ng build --configuration production",
    "build:development": "ng build --configuration development",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.app.json",
    "cap:sync": "npm run build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@angular/common": "20.3.31",
    "@angular/compiler": "20.3.31",
    "@angular/core": "20.3.31",
    "@angular/forms": "20.3.31",
    "@angular/platform-browser": "20.3.31",
    "@angular/platform-browser-dynamic": "20.3.31",
    "@angular/router": "20.3.31",
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.0.0",
    "@capacitor/core": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@ionic/angular": "8.8.19",
    "@types/d3-geo": "^3.1.1",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "ionicons": "8.1.0",
    "qrcode": "1.5.4",
    "rxjs": "7.8.2",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.37",
    "@angular/cli": "20.3.37",
    "@angular/compiler-cli": "20.3.31",
    "@capacitor/cli": "7.6.9",
    "@ionic/angular-toolkit": "12.3.0",
    "@types/qrcode": "1.5.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
